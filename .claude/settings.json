{
  "permissions": {
    "defaultMode": "plan",
    "deny": [
      "Read(~/.aws/**)",
      "Edit(~/.aws/**)",
      "Read(.env)",
      "Edit(.env)",
      "Bash(terraform apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform -chdir=* apply *)",
      "Bash(terraform -chdir=* destroy *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(gh pr merge *)",
      "Bash(gh repo delete *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git tag *)",
      "Bash(gh release *)",
      "Bash(gh api *)",
      "Bash(aws *)"
    ]
  }
}
