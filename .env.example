# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# AWS: LocalStack during development (see docs/local-vs-aws.md)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=eu-central-1
AWS_PROFILE=localstack
# The simulator's Kinesis publisher ignores AWS_PROFILE and every ~/.aws file: it takes these two
# from the environment only and refuses to start without them. LocalStack accepts the dummy `test`.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LLM: provider and model are configuration, never hard-coded (NFR-14)
LLM_PROVIDER=ollama
LLM_MODEL=<model-name>
OLLAMA_BASE_URL=http://localhost:11434

# Simulator: directory holding catalogue.yaml, config/, scenarios/ and schema/.
# Leave unset to use the simulator/ directory of the source tree; the container image sets it.
# SIM_HOME=

# Simulator command line (vtda-simulator, make stream). Each variable has a matching argument,
# which wins; unset or empty means the default shown. Transport rates live in
# simulator/config/stream.yaml only.
# SIM_SEED=42
# SIM_VEHICLES=           # default: the fleet size of simulator/config/fleet.yaml
# SIM_DAYS=1
# SIM_TARGET=stdout       # stdout, file or kinesis
# SIM_OUT_FILE=           # required by the file target (JSON Lines)
# SIM_KINESIS_STREAM=     # required by the kinesis target (LocalStack only, see AWS above)
# SIM_MODE=batch          # batch, or paced (real time)
# SIM_START_DATE=         # YYYY-MM-DD; default: start_date of simulator/config/stream.yaml
# SIM_MAX_MESSAGES=       # default: no limit

# Vector store
QDRANT_URL=http://localhost:6333
