# Copy to .env and adjust. .env is git-ignored; never commit real credentials.

# AWS: LocalStack during development (see docs/local-vs-aws.md)
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=eu-central-1
AWS_PROFILE=localstack
# The simulator's Kinesis publisher ignores AWS_PROFILE and every ~/.aws file: it takes these two
# from the environment only and refuses to start without them. LocalStack accepts the dummy `test`.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# LLM: provider and model are configuration, never hard-coded (NFR-14)
LLM_PROVIDER=ollama
LLM_MODEL=<model-name>
OLLAMA_BASE_URL=http://localhost:11434

# Simulator: directory holding catalogue.yaml, config/, scenarios/ and schema/.
# Leave unset to use the simulator/ directory of the source tree; the container image sets it.
# SIM_HOME=

# Vector store
QDRANT_URL=http://localhost:6333
